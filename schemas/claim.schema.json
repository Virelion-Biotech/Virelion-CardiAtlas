{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelionbiotech.netlify.app/schemas/claim.schema.json",
  "title": "CardiAtlas Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "predicate",
    "object",
    "polarity",
    "evidence_ids",
    "schema_version",
    "version",
    "citations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "polarity": {
      "enum": [
        "supports",
        "refutes",
        "mixed",
        "unknown"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "claim_evidence.schema.json"
      }
    }
  }
}
