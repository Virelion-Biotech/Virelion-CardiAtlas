{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-CardiAtlas/blob/main/schemas/intervention_record.schema.json",
  "title": "CardiAtlas Intervention Record",
  "type": "object",
  "required": ["id", "record_type", "name", "intervention_type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "record_type": {"const": "intervention"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "intervention_type": {"type": "string"},
    "target": {"type": "string"},
    "context": {"type": "string"},
    "observed_outcomes": {"type": "array", "items": {"type": "string"}},
    "phenotype_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"const": "0.3"}
  }
}
