{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-CardiAtlas/blob/main/schemas/study_record.schema.json",
  "title": "CardiAtlas Study Record",
  "type": "object",
  "required": ["id", "record_type", "name", "accession", "repository"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "record_type": {"const": "study"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "accession": {"type": "string", "minLength": 1},
    "repository": {"type": "string"},
    "title": {"type": "string"},
    "organism": {"type": "string"},
    "tissues": {"type": "array", "items": {"type": "string"}},
    "modalities": {"type": "array", "items": {"type": "string"}},
    "dataset_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "design": {"type": "string"},
    "publication_ids": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"const": "0.3"}
  }
}
