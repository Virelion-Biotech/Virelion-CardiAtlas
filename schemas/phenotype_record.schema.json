{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelion-biotech.github.io/Virelion-CardiAtlas/schemas/phenotype_record.schema.json",
  "title": "CardiAtlas Phenotype Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "name"
  ],
  "properties": {
    "associated_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "manifestations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurable_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "record_type": {
      "const": "phenotype"
    },
    "schema_version": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
