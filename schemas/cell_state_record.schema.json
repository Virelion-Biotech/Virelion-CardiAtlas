{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelion-biotech.github.io/Virelion-CardiAtlas/schemas/cell_state_record.schema.json",
  "title": "CardiAtlas Cell State Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "name"
  ],
  "properties": {
    "cell_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "marker_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "parent_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pathways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phenotypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_type": {
      "const": "cell_state"
    },
    "schema_version": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "species": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
