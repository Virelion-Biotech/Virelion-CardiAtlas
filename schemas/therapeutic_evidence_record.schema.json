{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelion-biotech.github.io/Virelion-CardiAtlas/schemas/therapeutic_evidence_record.schema.json",
  "title": "CardiAtlas Therapeutic Intervention Evidence Record",
  "type": "object",
  "required": ["id", "record_type", "name"],
  "properties": {
    "id": {"type": "string"},
    "record_type": {"const": "therapeutic_evidence"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "schema_version": {"const": "0.3"},
    "evidence_class": {"enum": ["myocardial_regeneration", "myocardial_repair", "myocardial_preservation", "genetic_disease_modification", "vascular_tissue_engineering", "immune_modulation", "other"]},
    "modality": {"enum": ["circRNA", "modRNA", "siRNA", "ASO", "AAV", "gene_editing", "cell_therapy", "engineered_tissue", "hydrogel", "small_molecule", "biologic", "immune_intervention", "other"]},
    "product_id": {"type": ["string", "null"]},
    "target_or_genotype": {"type": ["string", "null"]},
    "payload_or_construct": {"type": ["string", "null"]},
    "delivery_method": {"type": ["string", "null"]},
    "proposed_mechanism": {"type": "string"},
    "model_system": {"type": "string"},
    "species": {"type": ["string", "null"]},
    "dose": {"type": ["string", "null"]},
    "schedule": {"type": ["string", "null"]},
    "comparator": {"type": ["string", "null"]},
    "endpoints": {"type": "array", "items": {"type": "object"}},
    "analysis_population": {"type": ["string", "null"]},
    "denominator": {"type": ["string", "null"]},
    "follow_up": {"type": ["string", "null"]},
    "subgroup_analysis": {"type": ["string", "null"]},
    "multiplicity_handling": {"type": ["string", "null"]},
    "safety_findings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_locator": {"type": "object"},
    "curation_status": {"enum": ["unreviewed", "source_checked", "expert_reviewed"]}
  },
  "additionalProperties": false
}
