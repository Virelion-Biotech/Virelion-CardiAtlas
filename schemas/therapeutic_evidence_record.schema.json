{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelion-biotech.github.io/Virelion-CardiAtlas/schemas/therapeutic_evidence_record.schema.json",
  "title": "CardiAtlas Therapeutic Intervention Evidence Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "name"
  ],
  "properties": {
    "analysis_population": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparator": {
      "type": [
        "string",
        "null"
      ]
    },
    "curation_status": {
      "enum": [
        "unreviewed",
        "source_checked",
        "expert_reviewed"
      ]
    },
    "delivery_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "denominator": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    },
    "dose": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_class": {
      "enum": [
        "myocardial_regeneration",
        "myocardial_repair",
        "myocardial_preservation",
        "genetic_disease_modification",
        "vascular_tissue_engineering",
        "immune_modulation",
        "other"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "modality": {
      "enum": [
        "circRNA",
        "modRNA",
        "siRNA",
        "ASO",
        "AAV",
        "gene_editing",
        "cell_therapy",
        "engineered_tissue",
        "hydrogel",
        "small_molecule",
        "biologic",
        "immune_intervention",
        "other"
      ]
    },
    "model_system": {
      "type": "string"
    },
    "multiplicity_handling": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "payload_or_construct": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_mechanism": {
      "type": "string"
    },
    "record_type": {
      "const": "therapeutic_evidence"
    },
    "safety_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_locator": {
      "type": "object"
    },
    "species": {
      "type": [
        "string",
        "null"
      ]
    },
    "subgroup_analysis": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_or_genotype": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
