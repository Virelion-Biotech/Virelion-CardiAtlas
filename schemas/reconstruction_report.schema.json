{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-CardiAtlas/schemas/reconstruction_report.schema.json",
  "title": "CardiAtlas GEO Reconstruction Report",
  "type": "object",
  "required": ["dataset_id", "study_id", "sample_count", "reconstructed_subjects", "condition_groups", "timepoints", "regions", "modalities", "warnings", "decisions"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 0},
    "reconstructed_subjects": {"type": "integer", "minimum": 0},
    "condition_groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "timepoints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "regions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "modalities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "raw", "normalized", "confidence", "source_key"],
        "properties": {
          "field": {"type": "string"},
          "raw": {"type": "string"},
          "normalized": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_key": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
