{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardiAtlas Relation",
  "type": "object",
  "required": ["subject", "predicate", "object"],
  "properties": {
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"enum": ["supports", "refutes", "mixed_evidence_for", "expressed_in", "marks", "associated_with", "observed_in", "involves", "derived_from", "part_of", "has_sample", "has_dataset", "uses_modality", "occurs_in", "precedes", "responds_to", "measures"]},
    "object": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
